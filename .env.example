# Copy to .env.local for local development. Never commit real secrets.

# Random secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Postgres connection string (e.g. from Neon). Leave unset locally to use the
# embedded PGlite database stored in PGLITE_DATA_DIR (default: .data/pglite).
# DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite

# Also encrypts webhook signing secrets: changing BETTER_AUTH_SECRET means
# webhooks need a new signing secret.

# Protects /api/cron/webhooks (Vercel sends it automatically when set).
# CRON_SECRET=

# Let webhooks reach localhost/private networks. Only for local testing;
# on automatically in `npm run dev`.
# ALLOW_PRIVATE_WEBHOOK_URLS=1

# Media storage. On Vercel, connect a Blob store (Storage → Blob) to set this.
# Without it, files are stored in MEDIA_DIR (default .data/media) outside production.
# BLOB_READ_WRITE_TOKEN=
# MEDIA_DIR=.data/media
# Allow local media storage under `npm start` (local production testing only).
# ALLOW_LOCAL_MEDIA=1
